# Copia este archivo como .env y completa los valores.
# El archivo .env NUNCA se sube al repositorio (esta en .gitignore).

# --- Modelo de lenguaje (opcional pero recomendado) ---
# Con esta llave la asesora redacta respuestas naturales y mejor razonadas.
# SIN ella la aplicacion SIGUE FUNCIONANDO: responde directamente desde el corpus
# normativo, citando los mismos articulos. Menos elocuente, igual de fiable.
# Como obtenerla: https://console.anthropic.com -> API Keys -> Create Key
ANTHROPIC_API_KEY=

# Modelo a usar. Por defecto claude-opus-5.
CLAUDE_MODEL=claude-opus-5

# Alternativa gratuita recomendada por la guia del reto.
# Se obtiene en https://aistudio.google.com/apikey (gratis, sin tarjeta).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Voz (opcional) ---
# Si las dejas vacias, la asesora habla con la voz del navegador, que es
# gratuita y funciona sin internet.
# Se obtienen en https://fish.audio -> API Keys, y el id de la voz elegida.
FISH_API_KEY=
FISH_VOICE_ID=
